    "url": "https://github.com/ORDNET/ORDnet-web3names.git"
  },
  "keywords": [
    "bsv",
    "sns",
    "web3",
    "domains",
    "ordinals",
    "odnca",
    "resolver"
  ],
  "author": "ORDnet / ODNCA",
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "@bsv/sdk": "^1.1.0"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "peerDependencies": {
    "@bsv/sdk": ">=1.1.0"
  },
